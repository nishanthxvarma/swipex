# Environment
ENV=production
DEBUG=false
PROJECT_NAME="SwipeX API"

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/swipex_db

# Security & JWT
SECRET_KEY=generate-a-secure-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma separated)
CORS_ORIGINS=https://swipexai.vercel.app,http://localhost:3000

# Optional Email / Notification Service Provider Credentials
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=notifications@swipex.ai
